# Copie este arquivo para .env e preencha com as chaves oficiais.
# Nunca versione o .env.

# --- Provedores de IA ---
# Embeddings (ondas 2 e 3)
OPENAI_API_KEY=
# Geração (onda 4)
ANTHROPIC_API_KEY=

# --- Modelos ---
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=claude-opus-5-5

# --- Documentos e banco vetorial (Chroma) ---
DOCS_DIR=docs
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=xperiun_docs

# --- Chunking e recuperação ---
CHUNK_SIZE=350
CHUNK_OVERLAP=52
TOP_K=3
